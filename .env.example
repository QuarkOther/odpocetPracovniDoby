MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme

# Adresa hostu, na které nginx poslouchá (port 13400). Na ni míří Cloudflare Tunnel.
# 127.0.0.1 = dostupné jen z localhostu (doporučeno, pokud cloudflared běží na stejném stroji).
BIND_ADDRESS=127.0.0.1

# Adresa hostu, na které je zveřejněna MySQL (port 3307), např. pro DBeaver.
# 127.0.0.1 = jen z localhostu; IP serveru (např. 10.10.8.30) = z celé lokální sítě.
MYSQL_BIND_ADDRESS=127.0.0.1
